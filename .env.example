# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
TRUSTED_PROXY_HOPS=0

DATABASE_URL=postgres://app:app@localhost:5433/app
BLOB_ROOT=var/blobs

# Serves full failure detail (stack, SQL, bound params) at GET /api/devtools/errors.
# Defaults on outside production; NODE_ENV=production refuses to boot with it on.
DEVTOOLS_ENABLED=

# Set to serve the built SPA from the API server (the Docker image sets it).
# Unset locally, where Vite serves the client on :5173.
CLIENT_DIST_PATH=

# Required in production (openssl rand -base64 32). Dev has an insecure built-in default.
# The Docker stack runs NODE_ENV=production, so `docker compose up` needs both set.
FIELD_ENCRYPTION_KEY=
EMAIL_LOOKUP_PEPPER=

# Required in production. Unset (or blank) locally writes emails to var/mail/*.eml instead;
# blank in the Docker stack routes mail to the bundled Mailpit instead.
SMTP_URL=
MAIL_FROM=no-reply@example.com

MAX_UPLOAD_BYTES=2147483648
MAX_CHUNK_BYTES=4194320
ACCOUNT_QUOTA_BYTES=10737418240
TRANSFER_DEFAULT_TTL_HOURS=168
TRANSFER_MAX_TTL_HOURS=720
DOWNLOAD_GRANT_TTL_MINUTES=15
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=14

# Docker Compose only. APP_ORIGIN must match how the browser reaches the app.
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
MAILPIT_UI_PORT=8025
DEV_ORIGIN=http://localhost:5173
